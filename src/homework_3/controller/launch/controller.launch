<launch>
  <!-- load parameter file -->
  <rosparam file="$(find controller)/config/simulator_params.yaml" command="load"/>
  <rosparam param="/use_sim_time">true</rosparam>
  <remap from="/lookahead_cmd" to="/tb_cmd"/>
  <node pkg="controller" type="robot_simulator_node" name="tb_simulator" output="screen"/>
   <node pkg="controller" type="lookahead_controller_node" name="la" output="screen" />
  
  <!-- <node pkg="homework_3" type="trajectory_generator_node" name="trajectory" output="screen" /> -->
</launch>
