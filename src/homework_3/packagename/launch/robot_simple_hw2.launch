<launch>
  <!-- load parameter file -->
  <rosparam file="$(find homework_3)/config/simulator_params.yaml" command="load"/>
  <rosparam param="/use_sim_time">true</rosparam>
  
  <node pkg="homework_3" type="robot_simulator_node" name="tb_simulator" output="screen" />
  <node pkg="homework_3" type="loop_trajectory_node" name="tb_controller" output="screen" />
</launch>
