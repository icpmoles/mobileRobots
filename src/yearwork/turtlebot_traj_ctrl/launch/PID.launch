<launch>
  <!-- load parameter file -->
  <rosparam file="$(find turtlebot_traj_ctrl)/config/PID_params.yaml" command="load"/>
  <rosparam param="/use_sim_time">true</rosparam>
  <node name="PID Controller" 
          pkg="turtlebot_traj_ctrl"
          type="tb_ctrl_node"
          output="screen"
    />
</launch>
