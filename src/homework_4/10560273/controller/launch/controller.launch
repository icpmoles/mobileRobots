<launch>
  <!-- load parameter file -->
  <rosparam file="$(find controller)/config/simulation_params.yaml" command="load"/>
  <rosparam param="/use_sim_time">true</rosparam>
  <!-- <remap from="/lookahead_cmd" to="/cmd"/> -->
  <node pkg="simulator" type="simulator_node" name="tb_simulator" output="screen"/>
   <node pkg="controller" type="feedback_node" name="la" output="screen" />
  
  <!-- <node pkg="homework_3" type="trajectory_generator_node" name="trajectory" output="screen" /> -->
</launch>
