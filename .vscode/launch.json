{
    "version": "0.2.0",
    
    "configurations": [
        
        {
            "name": "ROS: Attach",
            "type": "ros",
            "request": "attach"
        },
        {
            "name": "ROS: Launch Lookahead",
            "type": "ros",
            "request": "launch",
            "target": "${workspaceFolder}/src/homework_3/controller/launch/controller.launch",
            "preLaunchTask": "make_debug"
        },
        {
            "name": "ROS: Launch La & PI",
            "type": "ros",
            "request": "launch",
            "target": "${workspaceFolder}/src/homework_3/homework4pkg/launch/hw4.launch",
            "preLaunchTask": "make_debug"
        },
        {
            "name": "ROS: Launch TurtleBot Sim",
            "type": "ros",
            "request": "launch",
            "target": "${workspaceFolder}/src/yearwork/turtlebot_simulator/launch/simulator.launch",
            "preLaunchTask": "make_debug"
        },
        {
            "name": "C/C++: g++-9 build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++-9 build active file",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}